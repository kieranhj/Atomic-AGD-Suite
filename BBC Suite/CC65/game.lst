001E60  3               rbloc:
001E60  3               	lda #<eop		; reset temp blockpointer
001E60  3               	sta tmp
001E60  3               	lda #>eop
001E60  3               	sta tmp+1
001E60  3               
001E60  3               rbloc2:
001E60  3               	lda tmp			; check for last block
001E60  3               	cmp pbptr
001E60  3               	bne rbloc1
001E60  3               	lda tmp+1
001E60  3               	cmp pbptr+1
001E60  3               	bne rbloc1
001E60  3               	rts
001E60  3               rbloc1:
001E60  3               	ldy #0
001E60  3               	lda (tmp),y		; check if block for this scno
001E60  3               	cmp scno
001E60  3               	bne rbloc0		; if not, skip
001E60  3               	iny
001E60  3               	lda (tmp),y		; get y
001E60  3               	sta dispy
001E60  3               	iny
001E60  3               	lda (tmp),y		; get x
001E60  3               	sta dispx
001E60  3               	iny
001E60  3               	lda (tmp),y		; get blocknr
001E60  3               	jsr pattr2		; draw block
001E60  3               rbloc0:
001E60  3               	clc			; point to next block
001E60  3               	lda tmp
001E60  3               	adc #4
001E60  3               	sta tmp
001E60  3               	bcc rbloc2
001E60  3               	inc tmp+1
001E60  3               	jmp rbloc2
001E60  3               .endif
001E60  3               ;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
