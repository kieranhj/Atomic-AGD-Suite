00126F  2  26 rr        	rol fntaddr+1
001271  2  06 rr        	asl fntaddr
001273  2  26 rr        	rol fntaddr+1
001275  2  06 rr        	asl fntaddr
001277  2  26 rr        	rol fntaddr+1
