0022FE  3               ; Sprite table
0022FE  3               ;------------------------------------------------------------------
0022FE  3               
0022FE  3               
0022FE  3               ; ix+0  = type.
0022FE  3               ; ix+1  = sprite image number.
0022FE  3               ; ix+2  = frame.
0022FE  3               ; ix+3  = y coord.
0022FE  3               ; ix+4  = x coord.
0022FE  3               
0022FE  3               ; ix+5  = new type.
0022FE  3               ; ix+6  = new image number.
0022FE  3               ; ix+7  = new frame.
0022FE  3               ; ix+8  = new y coord.
0022FE  3               ; ix+9  = new x coord.
0022FE  3               
0022FE  3               ; ix+10 = direction.
0022FE  3               ; ix+11 = parameter 1.
0022FE  3               ; ix+12 = parameter 2.
0022FE  3               ; ix+13 = jump pointer low.
0022FE  3               ; ix+14 = jump pointer high.
0022FE  3               ; ix+15 = data pointer low.
0022FE  3               ; ix+16 = data pointer high.
