001CEB  3               ; Display all shrapnel.
001CEB  3               ;----------------------------------------------------
001CEB  3               
001CEB  3               dshrp:
001CEB  3  A9 08        	lda #<plotde		; display routine.
001CED  3  8D EA 18     	sta proshx+1
001CF0  3  A9 1B        	lda #>plotde
001CF2  3  8D EB 18     	sta proshx+2
001CF5  3  20 D8 18     	jsr proshr		; process shrapnel.
001CF8  3               
001CF8  3  A9 FE        	lda #<prosh1		; processing routine.
001CFA  3  8D EA 18     	sta proshx+1
001CFD  3  A9 18        	lda #>prosh1
001CFF  3  8D EB 18     	sta proshx+2
001D02  3  60           	rts
