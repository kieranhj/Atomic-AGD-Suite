001334  2  06 rr        	asl z80_e  		; multiply char by 16.
001336  2  26 rr        	rol z80_d
001338  2  06 rr        	asl z80_e
00133A  2  26 rr        	rol z80_d
00133C  2  06 rr        	asl z80_e
00133E  2  26 rr        	rol z80_d
001340  2  06 rr        	asl z80_e
001342  2  26 rr        	rol z80_d
001344  2  18           	clc
001345  2  A5 rr        	lda z80_e
001347  2  69 B3        	adc #<(chgfx + data_address - data_start) 		; address of graphics.
001349  2  85 rr        	sta tileaddr
00134B  2  A5 rr        	lda z80_d
00134D  2  69 87        	adc #>(chgfx + data_address - data_start)
00134F  2  85 rr        	sta tileaddr+1
001351  2               
