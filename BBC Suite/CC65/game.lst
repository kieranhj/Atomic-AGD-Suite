003DBE  1               ; RELOCATION OF BEEB CODE FROM LOAD ADDRESS
003DBE  1               ;----------------------------------------------------------------------
003DBE  1               
003DBE  1               relocate:
003DBE  1               ; Issue *TAPE otherwise DFS goes mental that we've overwritten workspace from &E00 - &1100
003DBE  1               
003DBE  1  A9 8C            lda #$8C
003DC0  1  A2 0C            ldx #$0C
003DC2  1  A0 00            ldy #$00
003DC4  1  20 F4 FF         jsr OSBYTE					; *FX &8C,0,0 - *TAPE 1200
003DC7  1               
003DC7  1               ; Other one off initialisation could happen here...
003DC7  1               
003DC7  1               ; Relocate all code down to &E00
003DC7  1  A2 30        	ldx #>(end_asm - start_asm) + 1
003DC9  1  A0 00        	ldy #0
003DCB  1               reloop:
003DCB  1  B9 00 12     	lda load_address, y
003DCE  1  99 00 0E     	sta asm_code, y
003DD1  1  C8           	iny
003DD2  1  D0 F7        	bne reloop
003DD4  1  EE CD 41     	inc reloop + 2 + load_address - asm_code
003DD7  1  EE D0 41     	inc reloop + 5 + load_address - asm_code
003DDA  1  CA           	dex
003DDB  1  D0 EE        	bne reloop
003DDD  1  4C 03 0E     	jmp boot_game
