00122A  2  25 rr        	and z80_bp 			; mask away unwanted
00122C  2               
00122C  2  4A           	lsr a				; top nibble
00122D  2  4A           	lsr a
00122E  2  4A           	lsr a
00122F  2  4A           	lsr a
