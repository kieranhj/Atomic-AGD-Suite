0012E9  2  85 rr        	sta bufaddr
0012EB  2  A9 00        	lda #0
0012ED  2  85 rr        	sta bufaddr+1
0012EF  2  06 rr        	asl bufaddr  		; multiply char by 32
0012F1  2  26 rr        	rol bufaddr+1
0012F3  2  06 rr        	asl bufaddr
0012F5  2  26 rr        	rol bufaddr+1
0012F7  2  06 rr        	asl bufaddr
0012F9  2  26 rr        	rol bufaddr+1
0012FB  2  06 rr        	asl bufaddr
0012FD  2  26 rr        	rol bufaddr+1
