001EE0  3  38           	sec
001EE1  3  A5 rr        	lda z80_d
001EE3  3  E5 rr        	sbc z80_e		; subtract from column.
001EE5  3  85 rr        	sta z80_d
001EE7  3  E6 rr        	inc z80_a		; increment digit.
001EE9  3  E6 rr        	inc flag
001EEB  3  4C DA 1E     	jmp numdg1		; repeat until column is zero.
001EEE  3               numdg0:
001EEE  3  A0 00        	ldy #0
001EF0  3  A5 rr        	lda z80_a
001EF2  3  91 rr        	sta (z80_bc),y		; write digit to buffer.
001EF4  3  A5 rr        	lda flag
