001306  2  65 rr        	adc dispx
001308  2  69 00        	adc #<MAP
00130A  2  85 rr        	sta bufaddr
00130C  2  A5 rr        	lda bufaddr+1
00130E  2  69 03        	adc #>MAP
001310  2  85 rr        	sta bufaddr+1
001312  2  60           	rts
