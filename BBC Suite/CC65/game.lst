002CE0  3  60           	rts  				; no more room in table.
002CE1  3               ispr3:
002CE1  3  20 34 2D     	jsr cpsp			; initialise a sprite.
002CE4  3  C6 rr        	dec sprcnt			; one less space in the table.
002CE6  3  D0 D0        	bne ispr2
002CE8  3  60           	rts
002CE9  3               
002CE9  3               
002CE9  3               ;-----------------------------------------------------------------------
002CE9  3               ; Initialise sprites - but not player, we're keeping the old one.
002CE9  3               ;
002CE9  3               ; global:	-
002CE9  3               ; local:	x,y,ix
002CE9  3               ; calls:	cpsp
002CE9  3               ;-----------------------------------------------------------------------
002CE9  3               
002CE9  3               kspr:
002CE9  3  A2 0C        	ldx #NUMSPR			; sprite slots in table.
002CEB  3  A9 00        	lda #<sprtab 			; sprite table.
002CED  3  85 rr        	sta z80_x
002CEF  3  A9 0B        	lda #>sprtab
002CF1  3  85 rr        	sta z80_i
002CF3  3               kspr2:
002CF3  3  A0 00        	ldy #0
002CF5  3  B1 rr        	lda (z80_hl),y 			; fetch byte.
002CF7  3  C9 FF        	cmp #255 			; is it an end marker?
002CF9  3  D0 01        	bne :+
002CFB  3  60           	rts 				; yes, no more to do.
002CFC  3               :
002CFC  3  C9 00        	cmp #0
002CFE  3  D0 0E        	bne kspr1 			; no, add to table as normal.
002D00  3               
002D00  3  18           	clc 				; next sprite.
002D01  3  A5 rr        	lda z80_l
002D03  3  69 04        	adc #NMESIZ		 	; distance to next odd/even entry.
002D05  3  85 rr        	sta z80_l
002D07  3  90 02        	bcc :+
002D09  3  E6 rr        	inc z80_h
002D0B  3               :
002D0B  3  4C F3 2C     	jmp kspr2
002D0E  3               kspr1:
002D0E  3  A0 00        	ldy #0 				; fetch sprite type.
002D10  3  B1 rr        	lda (z80_ix),y
002D12  3  C9 FF        	cmp #255 			; is it enabled yet?
002D14  3  D0 08        	bne kspr4 			; yes, try another slot.
002D16  3               
002D16  3  A0 05        	ldy #5 				; next type.
002D18  3  B1 rr        	lda (z80_ix),y
002D1A  3  C9 FF        	cmp #255 			; is it enabled yet?
002D1C  3  F0 0F        	beq kspr3 			; no, process this one.
002D1E  3               kspr4:
002D1E  3  18           	clc 				; next sprite.
002D1F  3  A5 rr        	lda z80_x
002D21  3  69 13        	adc #TABSIZ		 	; distance to next odd/even entry.
002D23  3  85 rr        	sta z80_x
002D25  3  90 02        	bcc :+
002D27  3  E6 rr        	inc z80_i
002D29  3               :
002D29  3  CA           	dex	 			; repeat for remaining sprites.
002D2A  3  D0 E2        	bne kspr1
002D2C  3  60           	rts  				; no more room in table.
002D2D  3               kspr3:
002D2D  3  20 34 2D     	jsr cpsp 			; copy sprite to table.
002D30  3  CA           	dex	 			; one less space in the table.
002D31  3  D0 C0        	bne kspr2
002D33  3  60           	rts
002D34  3               
002D34  3               ;----------------------------------------------
002D34  3               ; Copy sprite from list to table.
002D34  3               ;
002D34  3               ; global:	hl,ix
002D34  3               ; local:	y
002D34  3               ; calls:	evnt09
002D34  3               ;----------------------------------------------
002D34  3               
002D34  3               cpsp:
002D34  3  A0 00        	ldy #0					; fetch byte from table.
002D36  3  B1 rr        	lda (z80_hl),y
002D38  3               	; y=var_Type
002D38  3  91 rr        	sta (z80_ix),y			; set up type.
002D3A  3  A0 05        	ldy #var_newType
002D3C  3  91 rr        	sta (z80_ix),y 			; set up type.
002D3E  3               
002D3E  3  E6 rr        	inc z80_l 				; move to next byte.
002D40  3  D0 02        	bne :+
002D42  3  E6 rr        	inc z80_h
002D44  3               :
002D44  3  A0 00        	ldy #0 					; fetch byte from table.
002D46  3  B1 rr        	lda (z80_hl),y
002D48  3  A0 06        	ldy #var_newImage
002D4A  3  91 rr        	sta (z80_ix),y			; set up image.
002D4C  3               
002D4C  3  E6 rr        	inc z80_l 				; move to next byte.
002D4E  3  D0 02        	bne :+
002D50  3  E6 rr        	inc z80_h
002D52  3               :
002D52  3  A0 00        	ldy #0
002D54  3  B1 rr        	lda (z80_hl),y 			; fetch byte from table.
002D56  3  A0 08        	ldy #var_newY
002D58  3  91 rr        	sta (z80_ix),y 			; set up coordinate.
002D5A  3               
002D5A  3  A9 C8        	lda #200 				; set initial coordinate off screen.
002D5C  3  A0 03        	ldy #var_Y
002D5E  3  91 rr        	sta (z80_ix),y
002D60  3               
002D60  3  E6 rr        	inc z80_l 				; move to next byte.
002D62  3  D0 02        	bne :+
002D64  3  E6 rr        	inc z80_h
002D66  3               :
002D66  3  A0 00        	ldy #0 					; fetch byte from table.
002D68  3  B1 rr        	lda (z80_hl),y
002D6A  3  A0 09        	ldy #var_newX
002D6C  3  91 rr        	sta (z80_ix),y 			; set up coordinate.
002D6E  3               
002D6E  3  E6 rr        	inc z80_l 				; move to next byte.
002D70  3  D0 02        	bne :+
002D72  3  E6 rr        	inc z80_h
002D74  3               :
002D74  3  A9 00        	lda #0					; zeroes in accumulator.
002D76  3  A0 07        	ldy #var_newFrame 		; reset frame number.
002D78  3  91 rr        	sta (z80_ix),y
002D7A  3  A0 0A        	ldy #var_Direction 		; reset direction.
002D7C  3  91 rr        	sta (z80_ix),y
002D7E  3  A0 0D        	ldy #var_jumpLo			; reset jump pointer low.
002D80  3  91 rr        	sta (z80_ix),y
002D82  3  A0 0E        	ldy #var_jumpHi	 		; reset jump pointer high.
002D84  3  91 rr        	sta (z80_ix),y
002D86  3               
002D86  3  A9 07        	lda #7					; default white ink - spriteink?
002D88  3  A0 11        	ldy #var_Ink
002D8A  3  91 rr        	sta (z80_ix),y
002D8C  3  A0 12        	ldy #var_newInk
002D8E  3  91 rr        	sta (z80_ix),y
002D90  3               
002D90  3  A9 FF        	lda #255 				; reset data pointer to auto-restore.
002D92  3  A0 10        	ldy #var_dataHi
002D94  3  91 rr        	sta (z80_ix),y
002D96  3               evis0:
002D96  3  A5 rr        	lda z80_i
002D98  3  48           	pha
002D99  3  A5 rr        	lda z80_x
002D9B  3  48           	pha
002D9C  3  A5 rr        	lda z80_h
002D9E  3  48           	pha
002D9F  3  A5 rr        	lda z80_l
002DA1  3  48           	pha
002DA2  3               
002DA2  3  20 9D 3C     	jsr evnt09 				; perform event.
002DA5  3               
002DA5  3  68           	pla
002DA6  3  85 rr        	sta z80_l
002DA8  3  68           	pla
002DA9  3  85 rr        	sta z80_h
002DAB  3  68           	pla
002DAC  3  85 rr        	sta z80_x
002DAE  3  68           	pla
002DAF  3  85 rr        	sta z80_i
002DB1  3               
002DB1  3  18           	clc
002DB2  3  A5 rr        	lda z80_x 			; distance to next odd/even entry.
002DB4  3  69 13        	adc #TABSIZ		 	; next sprite.
002DB6  3  85 rr        	sta z80_x
002DB8  3  90 02        	bcc :+
002DBA  3  E6 rr        	inc z80_i
002DBC  3               :
002DBC  3  60           	rts
002DBD  3               
002DBD  3               
002DBD  3               ;-------------------------------------
002DBD  3               ; Clear the play area window.
002DBD  3               ;-------------------------------------
002DBD  3               
002DBD  3               clw:
002DBD  3  AD 0C 18     	lda wintop			; get coordinates of window.
002DC0  3  85 rr        	sta dispy			; put into dispx for calculation.
002DC2  3  AD 0D 18     	lda winlft
002DC5  3  85 rr        	sta dispx
002DC7  3               
002DC7  3  AD 0E 18     	lda winhgt			; height of window.
002DCA  3  85 rr        	sta rrow			; copy to b register.
002DCC  3               clw3:
002DCC  3  AD 0F 18     	lda winwid 			; width of window.
002DCF  3  85 rr        	sta rcol
002DD1  3               clw2:
002DD1  3  20 B5 12     	jsr gprad 			; get print address.
002DD4  3  A9 00        	lda #0				; zero byte to write.
002DD6  3  A0 07        	ldy #7				; pixel height of each cell.
002DD8  3               clw1:
002DD8  3  91 rr        	sta (scraddr),y 	; copy to screen.
002DDA  3  88           	dey					; next screen row down.
002DDB  3  10 FB        	bpl clw1
002DDD  3               
002DDD  3  E6 rr        	inc dispx			; next column.
002DDF  3  C6 rr        	dec rcol			; one less to do.
002DE1  3  D0 EE        	bne clw2			; repeat for remaining columns.
002DE3  3               
002DE3  3  AD 0D 18     	lda winlft			; get left edge.
002DE6  3  85 rr        	sta dispx 			; reset x.
002DE8  3  E6 rr        	inc dispy 			; next line down.
002DEA  3               
002DEA  3  C6 rr        	dec rrow
002DEC  3  D0 DE        	bne clw3			; repeat down the screen.
002DEE  3               
002DEE  3  AD 0C 18     	lda wintop			; get coordinates of window.
002DF1  3  85 rr        	sta chary			; put into display position.
002DF3  3  AD 0D 18     	lda winlft
002DF6  3  85 rr        	sta charx
002DF8  3  60           	rts
002DF9  3               
002DF9  3               
002DF9  3               ;----------------------------------------------------------
002DF9  3               ; Effects code.
002DF9  3               ; Ticker routine is called 25 times per second.
002DF9  3               ;
002DF9  3               ; HL = txtscr = left text screen address
002DF9  3               ; DE = txtscr+txtwid-1 = right text screen address
002DF9  3               ; BC = txtpos = text scroller position
002DF9  3               ;
002DF9  3               ;----------------------------------------------------------
002DF9  3               
002DF9  3               .if sflag
002DF9  3               scrly:
002DF9  3               	rts
002DF9  3               	.word txtscr         	; get left screen address.
002DF9  3               	sta scr_l
002DF9  3               	lda txtscr+1
002DF9  3               	sta scr_l+1
002DF9  3               	sta scr_r+1
002DF9  3               
002DF9  3               	stx xtmp
002DF9  3               
002DF9  3               	clc         		; get right screen address.
002DF9  3               	lda scr_l
002DF9  3               	adc txtwid
002DF9  3               	sta scr_r
002DF9  3               	dec scr_r
002DF9  3               scrly1:
002DF9  3               	ldy txtwid		; set txtwide
002DF9  3               	dey
002DF9  3               	clc
002DF9  3               scrly0:
002DF9  3               	lda (scr_l),y		; scroll 1 line
002DF9  3               	rol a
002DF9  3               	sta (scr_l),y
002DF9  3               	dey
002DF9  3               	bpl scrly0
002DF9  3               
002DF9  3               	clc			; point to next line
002DF9  3               	lda scr_l
002DF9  3               	adc #32
002DF9  3               	sta scr_l
002DF9  3               	bcc scrly1		; repeat 8 times
002DF9  3               
002DF9  3               	lda txtpos 		; get text pointer.
002DF9  3               	sta scr_txt
002DF9  3               	lda txtpos+1
002DF9  3               	sta scr_txt+1
002DF9  3               
002DF9  3               	ldy #0
002DF9  3               	lda (scr_txt),y 		; find character we're displaying.
002DF9  3               	and #127 		; remove end marker bit if applicable.
002DF9  3               	cmp #ASCII_NEWLINE			; is it newline?
002DF9  3               	bne scrly5 		; no, it's okay.
002DF9  3               	cmp #ASCII_CR			; is it newline?
002DF9  3               	bne scrly5 		; no, it's okay.
002DF9  3               	lda #32			; convert to a space instead.
002DF9  3               scrly5:
002DF9  3               	sta fntaddr		; calculate char address
002DF9  3               	lda #0
002DF9  3               	sta fntaddr+1
002DF9  3               	asl fntaddr  		; multiply char by 8.
002DF9  3               	rol fntaddr+1
002DF9  3               	asl fntaddr
002DF9  3               	rol fntaddr+1
002DF9  3               	asl fntaddr
002DF9  3               	rol fntaddr+1
002DF9  3               	lda fntaddr
002DF9  3               	clc
002DF9  3               	adc FontPtr
002DF9  3               	sta scrly3+1		; that's the low byte.
002DF9  3               	lda fntaddr+1
002DF9  3               	adc FontPtr+1
002DF9  3               	sta scrly3+2		; add displacement.
002DF9  3               
002DF9  3               	ldx #0
002DF9  3               scrly3:
002DF9  3               	lda $3333,x		; get image of char line.
002DF9  3               	and txtbit
002DF9  3               	beq scrly2		; don't plot pixel
002DF9  3               	ldy scrline,x
002DF9  3               	lda (scr_r),y
002DF9  3               	clc
002DF9  3               	ora #1
002DF9  3               	sta (scr_r),y		; plot pixel
002DF9  3               scrly2:
002DF9  3               	inx			; next line of char.
002DF9  3               	cpx #8
002DF9  3               	bne scrly3
002DF9  3               
002DF9  3               	lsr txtbit		; bit of text to display.
002DF9  3               	bcs :+
002DF9  3               	rts
002DF9  3               :
002DF9  3               	ldy #0
002DF9  3               	lda (scr_txt),y 	; what was the character?
002DF9  3               	asl a	  		; end of message?
002DF9  3               	bcs scrly4
002DF9  3               	inc txtpos
002DF9  3               	bne :+
002DF9  3               	inc txtpos+1
002DF9  3               :
002DF9  3               	jmp scrly6 		; not yet - continue.
002DF9  3               scrly4:
002DF9  3               	lda txtini 		; start of scrolling message.
002DF9  3               	sta txtpos
002DF9  3               	lda txtini+1
002DF9  3               	sta txtpos+1
002DF9  3               scrly6:
002DF9  3               	lda #128
002DF9  3               	sta txtbit
002DF9  3               	ldx xtmp
002DF9  3               	rts
002DF9  3               
002DF9  3               scrline:	.byte $00,$20,$40,$60,$80,$a0,$c0,$e0
002DF9  3               
002DF9  3               ;-------------------------------------------------------
002DF9  3               ; Entry TICKER command
002DF9  3               ;
002DF9  3               ; Entry:
002DF9  3               ;  z80_b = message nr
002DF9  3               ;  z80_c = width
002DF9  3               ;-------------------------------------------------------
002DF9  3               
002DF9  3               iscrly:
002DF9  3               	jsr prescr 		; set up display position.
002DF9  3               
002DF9  3               	lda #<(msgdat + data_address - data_start) 		; text messages.
002DF9  3               	sta z80_l
002DF9  3               	lda #>(msgdat + data_address - data_start)
002DF9  3               	sta z80_h
002DF9  3               
002DF9  3               	lda z80_c 		; width.
002DF9  3               	sec
002DF9  3               	sbc #1			; subtract one.
002DF9  3               	cmp #32 		; is it between 1 and 32?
002DF9  3               	bcc :+
002DF9  3               	lda #$60
002DF9  3               	jmp iscrl0		; no, disable messages.
002DF9  3               :
002DF9  3               	ldx z80_b		; message number.
002DF9  3               	jsr getwrd 		; find message start.
002DF9  3               
002DF9  3               	lda z80_l		; set initial text position.
002DF9  3               	sta txtini
002DF9  3               	lda z80_h
002DF9  3               	sta txtini+1
002DF9  3               
002DF9  3               	lda #$ad		; code for lda adrr
002DF9  3               iscrl0:
002DF9  3               	sta scrly		; enable/disable scrolling routine.
002DF9  3               
002DF9  3               	jsr prescr 		; set up display position.
002DF9  3               	jsr gprad 		; get print address.
002DF9  3               
002DF9  3               	lda scraddr 		; set text screen address.
002DF9  3               	sta txtscr
002DF9  3               	lda scraddr+1
002DF9  3               	sta txtscr+1
002DF9  3               
002DF9  3               	lda z80_c		; width.
002DF9  3               	sta txtwid		; set width in working storage.
002DF9  3               
002DF9  3               	lda #128 		; start with leftmost bit.
002DF9  3               	sta txtbit
002DF9  3               
002DF9  3               	jmp scrly4
002DF9  3               .endif
002DF9  3               
002DF9  3               ;------------------------------------------------------------------
002DF9  3               ; Dig routine, conditional assembly depending on dflag
002DF9  3               ;------------------------------------------------------------------
002DF9  3               .if dflag
002DF9  3               dig:
002DF9  3               	and #3
002DF9  3               	beq digr		; dig right
002DF9  3               	cmp #1
002DF9  3               	beq digl		; dig left
002DF9  3               	cmp #2
002DF9  3               	beq digd		; dig down
002DF9  3               
002DF9  3               ; Dig up.
002DF9  3               
002DF9  3               digu:				; dig up
002DF9  3               	ldy #var_newY
002DF9  3               	lda (z80_ix),y
002DF9  3               	sec
002DF9  3               	sbc #2
002DF9  3               	sta dispy		; set y
002DF9  3               
002DF9  3               	iny
002DF9  3               	lda (z80_ix),y
002DF9  3               	sta dispx		; set x
002DF9  3               	jmp digv
002DF9  3               
002DF9  3               ; Dig down.
002DF9  3               
002DF9  3               digd:
002DF9  3               	ldy #var_newX
002DF9  3               	lda (z80_ix),y
002DF9  3               	sta dispx		; set x
002DF9  3               
002DF9  3               	dey
002DF9  3               	clc
002DF9  3               	lda (z80_ix),y
002DF9  3               	adc #16
002DF9  3               	sta dispy		; set y
002DF9  3               	jmp digv
002DF9  3               
002DF9  3               ; Dig left.
002DF9  3               
002DF9  3               digl:
002DF9  3               	ldy #var_newY
002DF9  3               	lda (z80_ix),y
002DF9  3               	sta dispy		; set y
002DF9  3               
002DF9  3               	iny
002DF9  3               	lda (z80_ix),y
002DF9  3               	sec
002DF9  3               	sbc #2			; x=x-2
002DF9  3               	sta dispx		; set x
002DF9  3               	jmp digh
002DF9  3               
002DF9  3               ; Dig right.
002DF9  3               
002DF9  3               digr:
002DF9  3               	ldy #var_newY
002DF9  3               	lda (z80_ix),y
002DF9  3               	sta dispy		; set y
002DF9  3               
002DF9  3               	iny
002DF9  3               	lda (z80_ix),y
002DF9  3               	clc
002DF9  3               	adc #16
002DF9  3               	sta dispx		; set x+16
002DF9  3               	jmp digh
002DF9  3               
002DF9  3               ; Vertical digging
002DF9  3               
002DF9  3               digv:
002DF9  3               	jsr tstbl		; check blocktype in MAP
002DF9  3               	jsr fdchk		; test if FODDER
002DF9  3               
002DF9  3               	clc
002DF9  3               	lda dispx		; look 1 cell down
002DF9  3               	adc #8
002DF9  3               	sta dispx
002DF9  3               	jsr tstbl		; check blocktype in MAP
002DF9  3               	jsr fdchk
002DF9  3               	lda dispx
002DF9  3               	and #7
002DF9  3               	bne :+
002DF9  3               	rts
002DF9  3               :
002DF9  3               	clc
002DF9  3               	lda dispx		; look 1 cell down
002DF9  3               	adc #8
002DF9  3               	sta dispx
002DF9  3               	jsr tstbl		; check blocktype in MAP
002DF9  3               	jmp fdchk
002DF9  3               
002DF9  3               ; Horizontal digging
002DF9  3               
002DF9  3               digh:
002DF9  3               	jsr tstbl		; check blocktype in MAP
002DF9  3               	jsr fdchk		; test if FODDER
002DF9  3               
002DF9  3               	clc
002DF9  3               	lda dispy		; look 1 cell down
002DF9  3               	adc #8
002DF9  3               	sta dispy
002DF9  3               	jsr tstbl		; check blocktype in MAP
002DF9  3               	jsr fdchk
002DF9  3               	lda dispy
002DF9  3               	and #7
002DF9  3               	bne :+
002DF9  3               	rts
002DF9  3               :
002DF9  3               	clc
002DF9  3               	lda dispy		; look 1 cell down
002DF9  3               	adc #8
002DF9  3               	sta dispy
002DF9  3               	jsr tstbl		; check blocktype in MAP
002DF9  3               	jmp fdchk
002DF9  3               
002DF9  3               digcnt:	.byte 0
002DF9  3               
002DF9  3               .endif
002DF9  3               
002DF9  3               ;------------------------------------------------------------------
002DF9  3               ; Sprite table
002DF9  3               ;------------------------------------------------------------------
002DF9  3               
002DF9  3               
002DF9  3               ; ix+0  = type.
002DF9  3               ; ix+1  = sprite image number.
002DF9  3               ; ix+2  = frame.
002DF9  3               ; ix+3  = y coord.
002DF9  3               ; ix+4  = x coord.
002DF9  3               
002DF9  3               ; ix+5  = new type.
