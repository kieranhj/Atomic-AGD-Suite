000F8E  2               ;	and #7
000F8E  2               	asl a
000F8E  2               	tax
000F8E  2               	lda ink_to_mode1,x
000F8E  2               	sta colour_byte
000F8E  2               	lda ink_to_mode1 + 1,x
000F8E  2               	sta colour_xor
000F8E  2               .endif
