001BE4  3  48           	pha
001BE5  3  A5 rr        	lda z80_x
001BE7  3  48           	pha
001BE8  3               
001BE8  3  20 52 1C     	jsr fpslot 		; find particle slot.
001BEB  3  B0 07        	bcs star7		; found one we can use.
001BED  3               star0:
