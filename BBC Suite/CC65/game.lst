001F61  3               ; Objects handling.
001F61  3               ; 32 bytes for image
001F61  3               ; 3 for room, y and x
001F61  3               ; 3 for starting room, y and x.
001F61  3               ; 254 = disabled.
001F61  3               ; 255 = object in player"s pockets.
001F61  3               ;---------------------------------------------------
001F61  3               
001F61  3               ;---------------------------------------------------
001F61  3               ; Show items present.
001F61  3               ;---------------------------------------------------
001F61  3               
001F61  3               shwob:
001F61  3  A9 58        	lda #<(objdta + data_address - data_start) 			; objects table.
