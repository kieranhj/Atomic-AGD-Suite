001E99  3  85 rr        	sta z80_c
001E9B  3  A9 21        	lda #>score
001E9D  3  85 rr        	sta z80_b
001E9F  3  60           	rts
001EA0  3               tidyu1:
001EA0  3  A0 05        	ldy #5
001EA2  3               tidyu3:
