001313  2               pattr2:
001313  2  85 rr        	sta z80_b		; store cell in b register for now.
001315  2  AA           	tax
001316  2  BD 33 8D     	lda bprop + data_address - data_start,x 		; block properties.
001319  2  85 rr        	sta z80_c
00131B  2  C9 08        	cmp #COLECT
00131D  2  D0 04        	bne :+
00131F  2  A5 rr        	lda z80_b
001321  2  85 rr        	sta colpatt
001323  2               :
001323  2  20 E7 12     	jsr pradd 		; get property buffer address.
001326  2  A5 rr        	lda z80_c
001328  2  A0 00        	ldy #0
00132A  2  91 rr        	sta (bufaddr),y 	; write property.
00132C  2  A5 rr        	lda z80_b 		; restore cell.
