001C52  3               fpslot:
001C52  3  A9 B6        	lda #<SHRAPN 		; shrapnel table.
001C54  3  85 rr        	sta z80_x
001C56  3  A9 09        	lda #>SHRAPN
001C58  3  85 rr        	sta z80_i
001C5A  3               
001C5A  3  A9 37        	lda #NUMSHR		; number of pieces in table.
001C5C  3  85 rr        	sta z80_b
001C5E  3               fpslt0:
001C5E  3  A0 00        	ldy #0
001C60  3  B1 rr        	lda (z80_ix),y		; get type.
001C62  3  0A           	asl a  			; is this slot in use?
001C63  3  90 01        	bcc :+
001C65  3  60           	rts			; no, we can use it.
001C66  3               :
001C66  3  18           	clc			; point to more shrapnel.
001C67  3  A5 rr        	lda z80_x
001C69  3  69 06        	adc #SHRSIZ
001C6B  3  85 rr        	sta z80_x
001C6D  3  90 02        	bcc :+
001C6F  3  E6 rr        	inc z80_i
001C71  3               :
001C71  3  C6 rr        	dec z80_b		; repeat for all shrapnel.
001C73  3  D0 E9        	bne fpslt0
001C75  3               
001C75  3  18           	clc
001C76  3  60           	rts 			; out of slots, can't generate anything.
001C77  3               
001C77  3               ;----------------------------------------------------
001C77  3               ; Create an explosion at sprite position.
001C77  3               ;----------------------------------------------------
001C77  3               
001C77  3               explod:
001C77  3  85 rr        	sta z80_c 		; particles to create.
001C79  3               
001C79  3  A5 rr        	lda z80_i 		; store pointer to sprite.
001C7B  3  48           	pha
001C7C  3  A5 rr        	lda z80_x
001C7E  3  48           	pha
001C7F  3               
001C7F  3  A0 08        	ldy #8
001C81  3  B1 rr        	lda (z80_ix),y 		; y coordinate.
001C83  3  85 rr        	sta z80_l
001C85  3  A0 09        	ldy #9
001C87  3  B1 rr        	lda (z80_ix),y		; x coordinate.
001C89  3  85 rr        	sta z80_h
001C8B  3               
001C8B  3  A9 B6        	lda #<SHRAPN		; shrapnel table.
001C8D  3  85 rr        	sta z80_x
001C8F  3  A9 09        	lda #>SHRAPN
001C91  3  85 rr        	sta z80_i
001C93  3               
001C93  3  A9 37        	lda #NUMSHR		; number of pieces in table.
001C95  3  85 rr        	sta explcnt
001C97  3               expld0:
001C97  3  A0 00        	ldy #0
001C99  3  B1 rr        	lda (z80_ix),y		; get type.
001C9B  3  0A           	asl a 			; is this slot in use?
001C9C  3  B0 16        	bcs expld1		; no, we can use it.
001C9E  3               expld2:
001C9E  3  18           	clc
001C9F  3  A5 rr        	lda z80_x
001CA1  3  69 06        	adc #SHRSIZ
001CA3  3  85 rr        	sta z80_x
001CA5  3  90 02        	bcc :+
001CA7  3  E6 rr        	inc z80_i
001CA9  3               :
001CA9  3  C6 rr        	dec explcnt		; repeat for all shrapnel.
001CAB  3  D0 EA        	bne expld0
001CAD  3               expld3:
001CAD  3  68           	pla			; restore sprite pointer.
001CAE  3  85 rr        	sta z80_x
001CB0  3  68           	pla
001CB1  3  85 rr        	sta z80_i
001CB3  3  60           	rts 			; out of slots, can't generate any more.
001CB4  3               
001CB4  3               expld1:
001CB4  3  A5 rr        	lda z80_c		; shrapnel counter.
001CB6  3  29 0F        	and #15			; 0 to 15.
001CB8  3  18           	clc			; add to x.
001CB9  3  65 rr        	adc z80_l
001CBB  3  A0 03        	ldy #3
001CBD  3  91 rr        	sta (z80_ix),y		; y coord.
001CBF  3               
001CBF  3  A5 rr        	lda seed3 		; crap random number.
001CC1  3  29 0F        	and #15			; 0 to 15.
001CC3  3  18           	clc 			; add to y.
001CC4  3  65 rr        	adc z80_h
001CC6  3  A0 05        	ldy #5
001CC8  3  91 rr        	sta (z80_ix),y		; x coord.
001CCA  3               
001CCA  3  A9 02        	lda #2
001CCC  3  A0 00        	ldy #0
001CCE  3  91 rr        	sta (z80_ix),y		; switch it on.
001CD0  3               
001CD0  3  20 BF 19     	jsr chkxy		; plot first position.
001CD3  3  20 E3 1C     	jsr qrand		; quick random angle.
001CD6  3  29 3C        	and #60 		; keep within range.
001CD8  3  A0 01        	ldy #1
001CDA  3  91 rr        	sta (z80_ix),y		; angle.
001CDC  3               
001CDC  3  C6 rr        	dec z80_c		; one less piece of shrapnel to generate.
001CDE  3  D0 BE        	bne expld2 		; back to main explosion loop.
001CE0  3  4C AD 1C     	jmp expld3 		; restore sprite pointer and exit.
001CE3  3               
001CE3  3               ;----------------------------------------------------
001CE3  3               ; Quick random
001CE3  3               ;----------------------------------------------------
001CE3  3               
001CE3  3               qrand:
001CE3  3  20 E4 25     	jsr random		; r register.
001CE6  3  45 rr        	eor seed3		; combine with seed.
001CE8  3  85 rr        	sta seed3 		; new seed.
001CEA  3  60           	rts
