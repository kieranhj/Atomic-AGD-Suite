001F1C  3               ;-----------------------------------------------------
001F1C  3               ; Multiply h by d and return in hl.
001F1C  3               ;
001F1C  3               ; Input:
001F1C  3               ;  H = first number
001F1C  3               ;  D = second number
001F1C  3               ;
001F1C  3               ; Output:
001F1C  3               ;  HL = result H x D
001F1C  3               ;-----------------------------------------------------
001F1C  3               
001F1C  3               imul:
001F1C  3  A5 rr        	lda z80_d		; HL = H * D
001F1E  3  85 rr        	sta z80_e
001F20  3  A5 rr        	lda z80_h
001F22  3  85 rr        	sta z80_c		; make c first multiplier.
001F24  3               imul0:
001F24  3  A9 00        	lda #0			; zeroise total.
001F26  3  85 rr        	sta z80_l
001F28  3  85 rr        	sta z80_h
001F2A  3               
001F2A  3  A5 rr        	lda z80_h
001F2C  3  85 rr        	sta z80_d		; zeroise high byte.
001F2E  3               
001F2E  3  A9 08        	lda #8			; repeat 8 times.
001F30  3  85 rr        	sta z80_b
001F32  3               imul1:
001F32  3  46 rr        	lsr z80_c		; rotate rightmost bit into carry.
001F34  3  90 0E        	bcc imul2		; wasn't set.
001F36  3  18           	clc			; bit was set, so add de.
001F37  3  A5 rr        	lda z80_l
001F39  3  65 rr        	adc z80_e
001F3B  3  85 rr        	sta z80_l
001F3D  3  A5 rr        	lda z80_h
001F3F  3  65 rr        	adc z80_d
001F41  3  85 rr        	sta z80_h
001F43  3  18           	clc 			; reset carry.
001F44  3               imul2:
001F44  3  06 rr        	asl z80_e 		; shift de 1 bit left.
001F46  3  26 rr        	rol z80_d
001F48  3  C6 rr        	dec z80_b
001F4A  3  D0 E6        	bne imul1		; repeat 8 times.
001F4C  3               
001F4C  3  60           	rts
001F4D  3               
001F4D  3               ;-----------------------------------------------
001F4D  3               ; Divide d by e and return in d, remainder in a.
001F4D  3               ;
001F4D  3               ; Input:
001F4D  3               ;  D = first number
001F4D  3               ;  E = second number
001F4D  3               ;
001F4D  3               ; Output:
001F4D  3               ;  D = result D/E
001F4D  3               ;  A = remainder
001F4D  3               ;-----------------------------------------------
001F4D  3               
001F4D  3               idiv:
001F4D  3  A9 00        	lda #0
001F4F  3  A0 08        	ldy #8		 	; bits to shift.
001F51  3  06 rr        	asl z80_d
001F53  3               idiv0:
001F53  3  2A           	rol a 			; multiply d by 2.
001F54  3  C5 rr        	cmp z80_e 		; test if e is smaller.
001F56  3  90 02        	bcc idiv1		; e is greater, no division this time.
001F58  3  E5 rr        	sbc z80_e		; subtract it.
001F5A  3               idiv1:
001F5A  3  26 rr        	rol z80_d		; rotate into d.
001F5C  3  88           	dey
001F5D  3  D0 F4        	bne idiv0		; repeat
001F5F  3  60           	rts
