00124E  2               ; _BEEB screen arrangement
00124E  2               
00124E  2  A5 rr        	lda z80_lp 			; get low byte of address.
001250  2  29 07        	and #7
001252  2  C9 07        	cmp #7				; is this last line of row?
001254  2  F0 03        	beq :+
001256  2               
001256  2               	; within same row can't increment page
001256  2  E6 rr        	inc z80_lp			; new low byte of address.
001258  2  60           	rts
001259  2               
001259  2               :
001259  2  18           	clc
00125A  2  A5 rr        	lda z80_lp
