001246  2  25 rr        	and newcol_byte
001248  2  A0 28        	ldy #40
00124A  2  51 rr        	eor (z80_hlp),y 	; XOR with what's there.
00124C  2  91 rr        	sta (z80_hlp),y 	; bung it in.
