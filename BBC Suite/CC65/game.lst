001BEE  3  85 rr        	sta z80_x
001BF0  3  68           	pla
001BF1  3  85 rr        	sta z80_i
001BF3  3  60           	rts 			; out of slots, can't generate anything.
001BF4  3               star7:
001BF4  3  A5 rr        	lda z80_c		; direction.
001BF6  3  29 03        	and #3 			; is it left?
001BF8  3  D0 03        	bne :+
001BFA  3  4C 2C 1C     	jmp star1 		; yes, it's left.
001BFD  3               :
001BFD  3  C9 01        	cmp #1 			; is it right?
001BFF  3  D0 03        	bne :+
001C01  3  4C 3C 1C     	jmp star2 		; yes, it's right.
001C04  3               :
001C04  3  C9 02        	cmp #2 			; is it up?
001C06  3  D0 03        	bne :+
001C08  3  4C 49 1C     	jmp star3 		; yes, it's up.
001C0B  3               :
001C0B  3  AC 11 18     	ldy wntopx 		; get edge of screen.
001C0E  3  C8           	iny			; down one pixel.
001C0F  3  98           	tya
001C10  3               star8:
001C10  3  A0 03        	ldy #3
001C12  3  91 rr        	sta (z80_ix),y 		; set y coord.
001C14  3  20 E3 1C     	jsr qrand 		; get quick random number.
001C17  3               star9:
001C17  3  A0 05        	ldy #5
001C19  3  91 rr        	sta (z80_ix),y		; set x position.
001C1B  3               
001C1B  3  A5 rr        	lda z80_c		; direction.
001C1D  3  29 03        	and #3			; zero to three.
001C1F  3  18           	clc
001C20  3  69 03        	adc #3			; 3 to 6 for starfield.
001C22  3  A0 00        	ldy #0
001C24  3  91 rr        	sta (z80_ix),y		; define particle as star.
001C26  3  20 BF 19     	jsr chkxy		; plot first position.
001C29  3  4C ED 1B     	jmp star0
001C2C  3               star1:
001C2C  3  20 E3 1C     	jsr qrand		; get quick random number.
001C2F  3  A0 03        	ldy #3
001C31  3  91 rr        	sta (z80_ix),y 		; set y coord.
001C33  3               
001C33  3  AD 14 18     	lda wnrgtx 		; get edge of screen.
001C36  3  18           	clc
001C37  3  69 0F        	adc #15			; add width of sprite minus 1.
001C39  3  4C 17 1C     	jmp star9
001C3C  3               star2:
001C3C  3  20 E3 1C     	jsr qrand 		; get quick random number.
001C3F  3  A0 03        	ldy #3
001C41  3  91 rr        	sta (z80_ix),y		; set y coord.
001C43  3               
