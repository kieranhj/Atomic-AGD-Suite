001377  2               
001377  2               ink_to_mode1:
001377  2  00 00        	.byte $00, $00 ^ $00 ; solid 0
001379  2  0F 00        	.byte $0f, $0f ^ $0f ; solid 1
00137B  2  F0 00        	.byte $f0, $f0 ^ $f0 ; solid 2
00137D  2  5A FF        	.byte $5a, $a5 ^ $5a ; stipple 1,2
00137F  2  A5 FF        	.byte $a5, $5a ^ $a5 ; stipple 2,1
001381  2               ;	.byte $da, $a7 ^ $da ; stripple 1,2,3
001381  2  5F F0        	.byte $5f, $af ^ $5f ; stipple 1,3
001383  2  F5 0F        	.byte $f5, $fa ^ $f5 ; stipple 2,3
001385  2  FF 00        	.byte $ff, $ff ^ $ff ; solid 3
001387  2               
001387  2               pixels_to_mode1:
001387  2  00 11 22 33  	.byte $00,$11,$22,$33,$44,$55,$66,$77
00138B  2  44 55 66 77  
00138F  2  88 99 AA BB  	.byte $88,$99,$aa,$bb,$cc,$dd,$ee,$ff
001393  2  CC DD EE FF  
