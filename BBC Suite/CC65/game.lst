001D03  3               ;------------------------------------------------------
001D03  3               ; Particle engine.
001D03  3               ;
001D03  3               ; Init particle data for 55 particles in SHRAPN table.
001D03  3               ; Every particle has 6 bytes.
001D03  3               ;
001D03  3               ; global:	-
001D03  3               ; local:	x,y,hl
001D03  3               ; calls:	-
001D03  3               ;------------------------------------------------------
001D03  3               
001D03  3               inishr:
001D03  3  A9 B6        	lda #<SHRAPN 		; table.
001D05  3  85 rr        	sta z80_l
001D07  3  A9 09        	lda #>SHRAPN
001D09  3  85 rr        	sta z80_h
001D0B  3               
001D0B  3  A0 00        	ldy #0
001D0D  3  A2 37        	ldx #NUMSHR		; shrapnel pieces to process.
001D0F  3               inish0:
001D0F  3  A9 FF        	lda #255 		; kill the shrapnel.
001D11  3  91 rr        	sta (z80_hl),y
001D13  3               
001D13  3  18           	clc 			; point there.
001D14  3  A5 rr        	lda z80_l
001D16  3  69 06        	adc #SHRSIZ		; distance to next.
001D18  3  85 rr        	sta z80_l
001D1A  3  90 02        	bcc :+
001D1C  3  E6 rr        	inc z80_h
001D1E  3               :
001D1E  3  CA           	dex
001D1F  3  D0 EE        	bne inish0 		; round again.
001D21  3  60           	rts
001D22  3               
001D22  3               ;------------------------------------------------------
001D22  3               ; Check for collision between laser and sprite.
001D22  3               ;------------------------------------------------------
001D22  3               
001D22  3               lcol:
001D22  3  A9 B6        	lda #<SHRAPN		; shrapnel table.
001D24  3  85 rr        	sta z80_l
001D26  3  A9 09        	lda #>SHRAPN
001D28  3  85 rr        	sta z80_h
001D2A  3               
001D2A  3  A9 37        	lda #NUMSHR		; number of pieces in table.
001D2C  3  85 rr        	sta z80_b
001D2E  3               lcol0:
001D2E  3  A0 00        	ldy #0
001D30  3  B1 rr        	lda (z80_hl),y 		; get type.
001D32  3  F0 10        	beq lcol1		; yes, check collision.
001D34  3               lcol3:
001D34  3  18           	clc			; point to more shrapnel.
001D35  3  A5 rr        	lda z80_l
001D37  3  69 06        	adc #SHRSIZ
001D39  3  85 rr        	sta z80_l
001D3B  3  90 02        	bcc :+
001D3D  3  E6 rr        	inc z80_h
001D3F  3               :
001D3F  3  C6 rr        	dec z80_b		; repeat for all shrapnel.
001D41  3  D0 EB        	bne lcol0
001D43  3  60           	rts 			; no collision, carry not set.
001D44  3               lcol1:
001D44  3  A0 03        	ldy #3
001D46  3  B1 rr        	lda (z80_hl),y		; get y.
001D48  3  38           	sec
001D49  3  A0 08        	ldy #8
001D4B  3  F1 rr        	sbc (z80_ix),y		; subtract sprite y.
001D4D  3               lcolh:
001D4D  3  C9 10        	cmp #16 		; within range?
001D4F  3  90 03        	bcc :+
001D51  3  4C 64 1D     	jmp lcol2		; no, missed.
001D54  3               :
001D54  3  A0 05        	ldy #5
001D56  3  B1 rr        	lda (z80_hl),y 		; get x.
001D58  3  38           	sec
001D59  3  A0 09        	ldy #9
001D5B  3  F1 rr        	sbc (z80_ix),y 		; subtract sprite y.
001D5D  3  C9 10        	cmp #16			; within range?
001D5F  3  B0 03        	bcs :+
001D61  3  4C 67 1D     	jmp lcol4 		; yes, collision occurred.
001D64  3               :
001D64  3               lcol2:
001D64  3  4C 34 1D     	jmp lcol3
001D67  3               lcol4:
001D67  3  38           	sec
001D68  3  60           	rts 			; return with carry set for collision.
001D69  3               .endif
