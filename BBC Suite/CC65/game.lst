001280  2  A5 rr        	lda fntaddr+1
001282  2  65 rr        	adc FontPtr+1
001284  2  85 rr        	sta fntaddr+1		; add displacement.
001286  2               pchark:
001286  2  20 B5 12     	jsr gprad		; get screen address.
001289  2  A0 00        	ldy #0
