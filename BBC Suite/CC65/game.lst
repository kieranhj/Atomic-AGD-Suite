000F2C  2               ;	eor #4
000F2C  2               ;	sta SpeakerBit
000F2C  2               ;	dec sndtyp
000F2C  2               ;	bne sndloop
000F2C  2               
000F2C  2               sndskip:
000F2C  2  68           	pla
000F2D  2  AA           	tax
000F2E  2  68           	pla
000F2F  2  A8           	tay
000F30  2  68           	pla
000F31  2  60           	rts
000F32  2               
000F32  2  00           sndtyp:	.byte 0
