00795B  1               ;----------------------------------------------------------------------
00795B  1               ; RELOCATION OF BEEB CODE FROM LOAD ADDRESS
00795B  1               ;----------------------------------------------------------------------
00795B  1               
00795B  1               relocate:
00795B  1               ; Issue *TAPE otherwise DFS goes mental that we've overwritten workspace from &E00 - &1100
00795B  1               
00795B  1  A9 8C            lda #$8C
00795D  1  A2 0C            ldx #$0C
00795F  1  A0 00            ldy #$00
007961  1  20 F4 FF         jsr OSBYTE					; *FX &8C,0,0 - *TAPE 1200
007964  1               
007964  1  78           	sei
007965  1  A9 7F        	lda #$7f
007967  1  8D 4E FE     	sta $fe4e					; disable all interupts
00796A  1  A9 82        	lda #$82
00796C  1  8D 4E FE     	sta $fe4e					; enable vsync interupt only
00796F  1  58           	cli
007970  1               
007970  1  A9 04        	lda #4						; select SWRAM
007972  1  85 F4            sta $f4
007974  1  8D 30 FE         sta $fe30
007977  1               
007977  1               ; Other one off initialisation could happen here...
007977  1               
007977  1               ; Relocate all code down to &E00
007977  1  A2 35        	ldx #>(data_start - start_asm) + 1
007979  1  A0 00        	ldy #0
00797B  1               reloop:
00797B  1  B9 00 12     	lda load_address, y
00797E  1  99 00 0E     	sta asm_code, y
007981  1  C8           	iny
007982  1  D0 F7        	bne reloop
007984  1  EE 7D 7D     	inc reloop + 2 + load_address - asm_code
007987  1  EE 80 7D     	inc reloop + 5 + load_address - asm_code
00798A  1  CA           	dex
00798B  1  D0 EE        	bne reloop
00798D  1               
00798D  1               ; Relocate all data up to &8000
00798D  1  A2 38        	ldx #>(end_asm - data_start) + 1
00798F  1  A0 00        	ldy #0
007991  1               uploop:
007991  1  B9 06 46     	lda data_start + load_address - asm_code, y
007994  1  99 00 80     	sta data_address, y
007997  1  C8           	iny
007998  1  D0 F7        	bne uploop
00799A  1  EE 93 7D     	inc uploop + 2 + load_address - asm_code
00799D  1  EE 96 7D     	inc uploop + 5 + load_address - asm_code
0079A0  1  CA           	dex
0079A1  1  D0 EE        	bne uploop
0079A3  1               
0079A3  1  4C 03 0E     	jmp boot_game
0079A3  1               
