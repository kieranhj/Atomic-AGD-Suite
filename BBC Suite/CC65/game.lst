0019C3  3  CD 11 18     	cmp wntopx		; window top.
0019C6  3  B0 03        	bcs :+			; compare with top window limit.
0019C8  3  4C 2C 1A     	jmp kilshr		; out of window, kill shrapnel.
0019CB  3               :
0019CB  3               ; left:   X>L		X=L	Ok
0019CB  3               
0019CB  3  A0 05        	ldy #5
0019CD  3  B1 rr        	lda (z80_ix),y	 	; fetch shrapnel coordinate.
0019CF  3  CD 12 18     	cmp wnlftx		; left edge.
0019D2  3  B0 03        	bcs :+			; compare with left window limit.
0019D4  3  4C 2C 1A     	jmp kilshr		; out of window, kill shrapnel.
0019D7  3               :
0019D7  3               ; bottom: B+15>Y	Y=B	Ok
0019D7  3               
0019D7  3  AD 13 18     	lda wnbotx		; point to bottom.
0019DA  3  18           	clc
0019DB  3  69 0F        	adc #15
0019DD  3  A0 03        	ldy #3
0019DF  3  D1 rr        	cmp (z80_ix),y	 	; fetch shrapnel coordinate.
0019E1  3  B0 03        	bcs :+			; compare with shrapnel x coordinate.
0019E3  3  4C 2C 1A     	jmp kilshr		; off screen, kill shrapnel..
0019E6  3               :
0019E6  3               ; right:  R+15>X	X=R	Ok
0019E6  3               
0019E6  3  AD 14 18     	lda wnrgtx		; point to right edge.
0019E9  3  18           	clc
0019EA  3  69 0F        	adc #15
