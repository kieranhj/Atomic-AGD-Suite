001BB3  3  18           	clc
001BB4  3  69 07        	adc #7			; mid-point of sprite.
001BB6  3  85 rr        	sta z80_l
001BB8  3               
001BB8  3  A0 09        	ldy #9
001BBA  3  B1 rr        	lda (z80_ix),y 		; x coordinate.
001BBC  3  18           	clc
001BBD  3  69 07        	adc #7			; mid-point of sprite.
