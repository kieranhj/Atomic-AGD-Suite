0022C0  3               ; Clear the play area window.
0022C0  3               ;-------------------------------------
0022C0  3               
0022C0  3               clw:
0022C0  3  AD FB 10     	lda wintop			; get coordinates of window.
0022C3  3  85 rr        	sta dispy			; put into dispx for calculation.
0022C5  3  AD FC 10     	lda winlft
0022C8  3  85 rr        	sta dispx
0022CA  3               
0022CA  3  AD FD 10     	lda winhgt			; height of window.
0022CD  3  85 rr        	sta rrow			; copy to b register.
0022CF  3               clw3:
0022CF  3  AD FE 10     	lda winwid 			; width of window.
0022D2  3  85 rr        	sta rcol
0022D4  3               clw2:
0022D4  3  20 F3 16     	jsr gprad 			; get print address.
0022D7  3  A9 00        	lda #0				; zero byte to write.
0022D9  3  A0 00        	ldy #0
0022DB  3               clw1:
0022DB  3  91 rr        	sta (scraddr),y 	; copy to screen.
0022DD  3  C8           	iny					; next screen row down.
0022DE  3  C0 08        	cpy #8
0022E0  3  90 F9        	bcc clw1
0022E2  3               
0022E2  3  E6 rr        	inc dispx			; next column.
0022E4  3  C6 rr        	dec rcol			; one less to do.
0022E6  3  D0 EC        	bne clw2			; repeat for remaining columns.
0022E8  3               
0022E8  3  AD FC 10     	lda winlft			; get left edge.
0022EB  3  85 rr        	sta dispx 			; reset x.
0022ED  3  E6 rr        	inc dispy 			; next line down.
0022EF  3               
0022EF  3  C6 rr        	dec rrow
0022F1  3  D0 DC        	bne clw3			; repeat down the screen.
0022F3  3               
0022F3  3  AD FB 10     	lda wintop			; get coordinates of window.
0022F6  3  85 rr        	sta chary			; put into display position.
0022F8  3  AD FC 10     	lda winlft
0022FB  3  85 rr        	sta charx
0022FD  3  60           	rts
0022FE  3               
0022FE  3               
0022FE  3               ;----------------------------------------------------------
0022FE  3               ; Effects code.
0022FE  3               ; Ticker routine is called 25 times per second.
0022FE  3               ;
0022FE  3               ; HL = txtscr = left text screen address
0022FE  3               ; DE = txtscr+txtwid-1 = right text screen address
0022FE  3               ; BC = txtpos = text scroller position
0022FE  3               ;
0022FE  3               ;----------------------------------------------------------
0022FE  3               
0022FE  3               .if sflag
0022FE  3               scrly:
0022FE  3               	rts
0022FE  3               	.word txtscr         	; get left screen address.
0022FE  3               	sta scr_l
0022FE  3               	lda txtscr+1
0022FE  3               	sta scr_l+1
0022FE  3               	sta scr_r+1
0022FE  3               
0022FE  3               	stx xtmp
0022FE  3               
0022FE  3               	clc         		; get right screen address.
0022FE  3               	lda scr_l
0022FE  3               	adc txtwid
0022FE  3               	sta scr_r
0022FE  3               	dec scr_r
0022FE  3               scrly1:
0022FE  3               	ldy txtwid		; set txtwide
0022FE  3               	dey
0022FE  3               	clc
0022FE  3               scrly0:
0022FE  3               	lda (scr_l),y		; scroll 1 line
0022FE  3               	rol a
0022FE  3               	sta (scr_l),y
0022FE  3               	dey
0022FE  3               	bpl scrly0
0022FE  3               
0022FE  3               	clc			; point to next line
0022FE  3               	lda scr_l
0022FE  3               	adc #32
0022FE  3               	sta scr_l
0022FE  3               	bcc scrly1		; repeat 8 times
0022FE  3               
0022FE  3               	lda txtpos 		; get text pointer.
0022FE  3               	sta scr_txt
0022FE  3               	lda txtpos+1
0022FE  3               	sta scr_txt+1
0022FE  3               
0022FE  3               	ldy #0
0022FE  3               	lda (scr_txt),y 		; find character we're displaying.
0022FE  3               	and #127 		; remove end marker bit if applicable.
0022FE  3               	cmp #ASCII_NEWLINE			; is it newline?
0022FE  3               	bne scrly5 		; no, it's okay.
0022FE  3               	lda #32			; convert to a space instead.
0022FE  3               scrly5:
0022FE  3               	sta fntaddr		; calculate char address
0022FE  3               	lda #0
0022FE  3               	sta fntaddr+1
0022FE  3               	asl fntaddr  		; multiply char by 8.
0022FE  3               	rol fntaddr+1
0022FE  3               	asl fntaddr
0022FE  3               	rol fntaddr+1
0022FE  3               	asl fntaddr
0022FE  3               	rol fntaddr+1
0022FE  3               	lda fntaddr
0022FE  3               	clc
0022FE  3               	adc FontPtr
0022FE  3               	sta scrly3+1		; that's the low byte.
0022FE  3               	lda fntaddr+1
0022FE  3               	adc FontPtr+1
0022FE  3               	sta scrly3+2		; add displacement.
0022FE  3               
0022FE  3               	ldx #0
0022FE  3               scrly3:
0022FE  3               	lda $3333,x		; get image of char line.
0022FE  3               	and txtbit
0022FE  3               	beq scrly2		; don't plot pixel
0022FE  3               	ldy scrline,x
0022FE  3               	lda (scr_r),y
0022FE  3               	clc
0022FE  3               	ora #1
0022FE  3               	sta (scr_r),y		; plot pixel
0022FE  3               scrly2:
0022FE  3               	inx			; next line of char.
0022FE  3               	cpx #8
0022FE  3               	bne scrly3
0022FE  3               
0022FE  3               	lsr txtbit		; bit of text to display.
0022FE  3               	bcs :+
0022FE  3               	rts
0022FE  3               :
0022FE  3               	ldy #0
0022FE  3               	lda (scr_txt),y 	; what was the character?
0022FE  3               	asl a	  		; end of message?
0022FE  3               	bcs scrly4
0022FE  3               	inc txtpos
0022FE  3               	bne :+
0022FE  3               	inc txtpos+1
0022FE  3               :
0022FE  3               	jmp scrly6 		; not yet - continue.
0022FE  3               scrly4:
0022FE  3               	lda txtini 		; start of scrolling message.
0022FE  3               	sta txtpos
0022FE  3               	lda txtini+1
0022FE  3               	sta txtpos+1
0022FE  3               scrly6:
0022FE  3               	lda #128
0022FE  3               	sta txtbit
0022FE  3               	ldx xtmp
0022FE  3               	rts
0022FE  3               
0022FE  3               scrline:	.byte $00,$20,$40,$60,$80,$a0,$c0,$e0
0022FE  3               
0022FE  3               ;-------------------------------------------------------
0022FE  3               ; Entry TICKER command
0022FE  3               ;
0022FE  3               ; Entry:
0022FE  3               ;  z80_b = message nr
0022FE  3               ;  z80_c = width
0022FE  3               ;-------------------------------------------------------
0022FE  3               
0022FE  3               iscrly:
0022FE  3               	jsr prescr 		; set up display position.
0022FE  3               
0022FE  3               	lda #<msgdat 		; text messages.
0022FE  3               	sta z80_l
0022FE  3               	lda #>msgdat
0022FE  3               	sta z80_h
0022FE  3               
0022FE  3               	lda z80_c 		; width.
0022FE  3               	sec
0022FE  3               	sbc #1			; subtract one.
0022FE  3               	cmp #32 		; is it between 1 and 32?
0022FE  3               	bcc :+
0022FE  3               	lda #$60
0022FE  3               	jmp iscrl0		; no, disable messages.
0022FE  3               :
0022FE  3               	ldx z80_b		; message number.
0022FE  3               	jsr getwrd 		; find message start.
0022FE  3               
0022FE  3               	lda z80_l		; set initial text position.
0022FE  3               	sta txtini
0022FE  3               	lda z80_h
0022FE  3               	sta txtini+1
0022FE  3               
0022FE  3               	lda #$ad		; code for lda adrr
0022FE  3               iscrl0:
0022FE  3               	sta scrly		; enable/disable scrolling routine.
0022FE  3               
0022FE  3               	jsr prescr 		; set up display position.
0022FE  3               	jsr gprad 		; get print address.
0022FE  3               
0022FE  3               	lda scraddr 		; set text screen address.
0022FE  3               	sta txtscr
0022FE  3               	lda scraddr+1
0022FE  3               	sta txtscr+1
0022FE  3               
0022FE  3               	lda z80_c		; width.
0022FE  3               	sta txtwid		; set width in working storage.
0022FE  3               
0022FE  3               	lda #128 		; start with leftmost bit.
0022FE  3               	sta txtbit
0022FE  3               
0022FE  3               	jmp scrly4
0022FE  3               .endif
0022FE  3               
