001E8B  3  CD 3B 21     	cmp hiscor 			; are we larger than high score digit?
001E8E  3  90 07        	bcc tidyu0			; high score is bigger.
001E90  3  D0 0E        	bne tidyu1			; score is greater, record new high score.
001E92  3  C8           	iny				; next digit of high score.
001E93  3  C0 06        	cpy #6
001E95  3  D0 F1        	bne tidyu2			; repeat for all digits
001E97  3               tidyu0:
