0019BF  3               ;----------------------------------------------------
0019BF  3               ; Check if coordinates are ok before redrawing at new position.
0019BF  3               ;
0019BF  3               ; left:   X>L		X=L	Ok
0019BF  3               ; right:  R+15>X	X=R	Ok
0019BF  3               ; top:    Y>T		Y=T	Ok
0019BF  3               ; bottom: B+15>Y	Y=B	Ok
0019BF  3               ;----------------------------------------------------
0019BF  3               
