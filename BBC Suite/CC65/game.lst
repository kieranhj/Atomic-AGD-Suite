001EBC  3               ;------------------------------------------------------------------
001EBC  3               ; Copy number passed in a to string position bc, right-justified.
001EBC  3               ;
001EBC  3               ; Input:
001EBC  3               ;  A  = number
001EBC  3               ;  BC = string address
001EBC  3               ;
001EBC  3               ; Output:
001EBC  3               ;  BC = string with number
001EBC  3               ;-----------------------------------------------------------------
001EBC  3               
001EBC  3               num2ch:
001EBC  3  85 rr        	sta z80_d		; Save number
001EBE  3               
001EBE  3  A9 00        	lda #0
001EC0  3  85 rr        	sta flag
001EC2  3               numdg3:
001EC2  3  A2 64        	ldx #100		; hundreds column.
001EC4  3  86 rr        	stx z80_e
001EC6  3  20 D6 1E     	jsr numdg		; show digit.
001EC9  3               numdg2:
001EC9  3  A2 0A        	ldx #10			; tens column.
001ECB  3  86 rr        	stx z80_e
001ECD  3  20 D6 1E     	jsr numdg		; show digit.
001ED0  3               
001ED0  3  E6 rr        	inc flag
001ED2  3  A2 01        	ldx #1			; units column.
001ED4  3  86 rr        	stx z80_e
001ED6  3               numdg:
