000F6C  2  96           	.byte $90 + COLOUR2
000F6D  2  A0           	.byte $a0 + COLOUR3
000F6E  2  B0           	.byte $b0 + COLOUR3
000F6F  2  C6           	.byte $c0 + COLOUR2
000F70  2  D6           	.byte $d0 + COLOUR2
