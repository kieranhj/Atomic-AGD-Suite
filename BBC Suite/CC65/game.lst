000F64  2  17           	.byte $10 + COLOUR0
000F65  2  23           	.byte $20 + COLOUR1
000F66  2  33           	.byte $30 + COLOUR1
000F67  2  47           	.byte $40 + COLOUR0
000F68  2  57           	.byte $50 + COLOUR0
000F69  2  63           	.byte $60 + COLOUR1
000F6A  2  73           	.byte $70 + COLOUR1
